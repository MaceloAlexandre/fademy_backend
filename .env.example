# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/fademy

# Server port
PORT=3000

# JWT secret (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# JWT token expiry
JWT_EXPIRES_IN=7d

# Bootstrap admin credentials (used by npm run seed)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_this_password
BOOTSTRAP_ADMIN_NAME=Admin

# bcrypt cost factor (10–12 recommended)
BCRYPT_ROUNDS=10

# S3 — presigned upload for profile photos (PLAT-03)
# Leave S3_ENDPOINT empty for real AWS S3; set it for S3-compatible providers (e.g. Contabo: https://eu2.contabostorage.com)
S3_ENDPOINT=
AWS_REGION=us-east-1
# For Contabo, the bucket is referenced as <tenant-id>:<bucket-name>
S3_BUCKET=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-iam-access-key-id
S3_SECRET_ACCESS_KEY=your-iam-secret-access-key
# Presign URL TTL in seconds (default 300 = 5 min)
S3_PRESIGN_TTL=300
# Max upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# CORS — React frontend origin (consumed by Plan 03 CORS middleware)
FRONTEND_ORIGIN=http://localhost:5173
